includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            # Extends a deliberately absent parent; @phpstan-ignore does not reach an extends
            # clause. Analysis only, so the class stays known to the test that names it.
            - tests/bundle/DependencyInjection/CompilerPass/Stub/ServiceWithUninstalledParent.php
